generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  description    String
  reportType     String    @map("report_type") @db.VarChar(50)
  siteLocation   String?   @map("site_location") @db.VarChar(255)
  incidentDate   DateTime? @map("incident_date")
  hazardName     String?   @map("hazard_name") @db.VarChar(255)
  energySource   String?   @map("energy_source") @db.VarChar(255)
  humanExposure  String?   @map("human_exposure")
  barrierName    String?   @map("barrier_name") @db.VarChar(255)
  barrierStatus  String?   @map("barrier_status") @db.VarChar(50)
  consequence    String?
  notes          String?
  sifPotential   String?   @map("sif_potential") @db.VarChar(50)
  analysis       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  embeddings     ReportEmbedding[]
  reviews        Review[]
  safetyEvents   SafetyEvent[]

  @@map("reports")
}

model ReportEmbedding {
  id        Int                      @id @default(autoincrement())
  reportId  Int                      @map("report_id")
  embedding Unsupported("vector(768)")?
  createdAt DateTime                 @default(now()) @map("created_at")
  report    Report                   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_embeddings")
}

model Review {
  id          Int      @id @default(autoincrement())
  reportId    Int      @map("report_id")
  reviewer    String   @db.VarChar(255)
  role        String?  @db.VarChar(255)
  decision    String   @db.VarChar(50)
  comments    String?
  submittedAt DateTime @default(now()) @map("submitted_at")
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model SafetyEvent {
  id            Int      @id @default(autoincrement())
  reportId      Int      @map("report_id")
  title         String   @db.VarChar(255)
  sifPotential  String   @map("sif_potential") @db.VarChar(50)
  decision      String   @db.VarChar(50)
  reviewer      String   @db.VarChar(255)
  hazardName    String?  @map("hazard_name") @db.VarChar(255)
  barrierStatus String?  @map("barrier_status") @db.VarChar(50)
  summary       String?
  decidedAt     DateTime @default(now()) @map("decided_at")
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("safety_events")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  userName      String   @map("user_name") @db.VarChar(255)
  action        String   @db.VarChar(255)
  entity        String   @db.VarChar(255)
  entityId      String?  @map("entity_id") @db.VarChar(255)
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model User {
  id           String           @id @default(cuid())
  name         String           @db.VarChar(120)
  email        String           @unique @db.VarChar(255)
  phone        String           @unique @db.VarChar(20)
  passwordHash String           @map("password")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  sessions     RefreshSession[]
  resets       PasswordReset[]
  documents    UploadedDocument[]

  @@map("users")
}

model UploadedDocument {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(120)
  sizeBytes Int      @map("size_bytes")
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("uploaded_documents")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}
